*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:sans-serif;
}

body{
background:#090012;
color:white;
min-height:100vh;
overflow-x:hidden;
}

.stars{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:
radial-gradient(circle,#ffffff 1px,transparent 1px);
background-size:40px 40px;
opacity:.2;
z-index:-1;
}

header{
text-align:center;
padding:20px;
font-size:30px;
font-weight:bold;
color:#c77dff;
text-shadow:0 0 20px #c77dff;
}

.page{
display:none;
padding:20px;
}

.active{
display:block;
}

.navbar{
position:fixed;
bottom:0;
left:0;
right:0;
height:65px;
background:#12041f;
display:flex;
justify-content:space-around;
align-items:center;
border-top:1px solid #7b2cbf;
}

.navbar button{
background:none;
border:none;
font-size:24px;
color:white;
}
@keyframes twinkle{
0%{opacity:.2}
50%{opacity:.8}
100%{opacity:.2}
}

.stars{
animation:twinkle 4s infinite;
}

.card{
background:rgba(255,255,255,.05);
backdrop-filter:blur(10px);
border:1px solid rgba(199,125,255,.3);
border-radius:15px;
padding:15px;
margin:10px 0;
box-shadow:0 0 15px rgba(157,78,221,.4);
}

.search{
width:100%;
padding:12px;
border:none;
border-radius:12px;
background:#1b1033;
color:white;
margin-bottom:15px;
}

.vip-card{
background:linear-gradient(135deg,#7b2cbf,#c77dff);
padding:20px;
border-radius:15px;
margin:10px 0;
text-align:center;
font-weight:bold;
}
const tg = window.Telegram.WebApp;
tg.expand();

function showPage(id){

document.querySelectorAll('.page')
.forEach(page=>page.classList.remove('active'));

document.getElementById(id)
.classList.add('active');

}
